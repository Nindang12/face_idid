# ============================================
# Cấu Hình Hệ Thống Face Recognition
# ============================================

# IP của máy chủ chính
HOST_IP=192.168.1.7

# ============================================
# Kafka Configuration
# ============================================
KAFKA_ADVERTISED_HOST=192.168.1.7
KAFKA_BOOTSTRAP_SERVERS=192.168.1.7:9092

# ============================================
# Spark Configuration (cài trên máy host)
# ============================================
SPARK_HOME=/opt/spark
SPARK_MASTER=spark://192.168.1.7:7077
SPARK_MASTER_HOST=192.168.1.7

# ============================================
# MinIO Configuration (Object Storage)
# ============================================
MINIO_ENDPOINT=192.168.1.7:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=face-recognition-data
MINIO_USE_SSL=false

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=faceid
POSTGRES_PASSWORD=faceid123
POSTGRES_DB=faceid
DATABASE_URL=postgresql://faceid:faceid123@192.168.1.7:5433/faceid

# ============================================
# Storage Configuration
# ============================================
UPLOAD_DIR=uploads
KNOWN_FACES_DIR=known_faces

# ============================================
# Branch Configuration (cho worker machines)
# ============================================
DEFAULT_BRANCH_ID=0
